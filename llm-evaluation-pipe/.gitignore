# ============================================================================
# .gitignore - LLM Evaluation Pipeline
# ============================================================================
# Specifies files and directories that Git should ignore
# ============================================================================

# Python Runtime Files
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Distribution / Packaging
# ----------------------------------------------------------------------------
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
# ----------------------------------------------------------------------------
venv/
env/
ENV/
env.bak/
venv.bak/
.venv
.virtualenv

# Environment Variables & Secrets
# ----------------------------------------------------------------------------
# NEVER commit API keys or secrets!
.env
.env.local
.env.*.local
*.env
secrets.json
config.local.py

# IDE & Editor Files
# ----------------------------------------------------------------------------
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
*.swp
*.swo
*~

# Emacs
*~
\#*\#
.\#*

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~

# Testing & Coverage
# ----------------------------------------------------------------------------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/
.pytest_cache/
nosetests.xml

# Evaluation Results & Outputs
# ----------------------------------------------------------------------------
# Output files generated by the pipeline
evaluation_results.json
results/
output/
*.result.json
evaluations/

# Logs
# ----------------------------------------------------------------------------
*.log
logs/
*.log.*
pip-log.txt
pip-delete-this-directory.txt

# Data Files (Optional - Uncomment if needed)
# ----------------------------------------------------------------------------
# Uncomment these lines if you don't want to commit data files
# data/*.json
# data/*.csv
# data/*.txt

# But keep the data directory structure
!data/.gitkeep

# Jupyter Notebooks
# ----------------------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb
# Uncomment if you want to track notebooks:
# !notebooks/*.ipynb

# Type Checking
# ----------------------------------------------------------------------------
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# Profiling
# ----------------------------------------------------------------------------
*.prof
.prof/

# Database
# ----------------------------------------------------------------------------
*.db
*.sqlite
*.sqlite3

# Cache & Temporary Files
# ----------------------------------------------------------------------------
cache/
.cache/
tmp/
temp/
*.tmp
*.bak
*.swp
.~*

# Documentation Build
# ----------------------------------------------------------------------------
docs/_build/
site/

# Package Manager Files
# ----------------------------------------------------------------------------
# Poetry
poetry.lock

# Pipenv
Pipfile.lock

# OS Generated Files
# ----------------------------------------------------------------------------
.Spotlight-V100
.Trashes
ehthumbs_vista.db

# Project Specific
# ----------------------------------------------------------------------------
# Add any project-specific files to ignore below
experiments/
scratch/
sandbox/
test_data/
*.draft.*